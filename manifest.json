{
  "manifest_version": 3,
  "name": "Sieve",
  "version": "0.1.0",
  "description": "Live chord detection — sift frequencies to find the notes",

  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "offscreen",
    "tabs",
    "sidePanel",
    "downloads",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Toggle Black Hole",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "32":  "assets/icons/icon32.png",
      "48":  "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "icons": {
    "16":  "assets/icons/icon16.png",
    "32":  "assets/icons/icon32.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
